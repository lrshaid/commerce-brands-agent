# Copy to .env (gitignored) and fill in. Do not commit real values.

CUBEJS_DEV_MODE=true

# --- BigQuery connection ---
CUBEJS_DB_TYPE=bigquery
CUBEJS_DB_BQ_PROJECT_ID=commerce-agents-dev
# Path INSIDE the container (mounted from ./gcp-key.json by docker-compose).
CUBEJS_DB_BQ_KEY_FILE=/cube/conf/gcp-key.json
# BigQuery location of the analytics dataset (US or a region like us-central1).
CUBEJS_DB_BQ_LOCATION=US

# --- APIs ---
# Enables the SQL API (Postgres wire) on this port.
CUBEJS_PG_SQL_PORT=15432
# Signing secret for API tokens (JWT). Generate a long random string:
#   openssl rand -hex 32
CUBEJS_API_SECRET=change-me-to-a-long-random-string

# --- Pre-aggregations ---
# Where rollups are stored/served. Cube Store runs embedded in dev mode; this
# points the local instance at the mounted .cubestore volume.
CUBEJS_CUBESTORE_HOST=
